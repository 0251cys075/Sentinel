# ─────────────────────────────────────────────────────────────
# Sentinel — environment variables
# Copy this file to `.env.local` and fill in your own values.
#
# Supabase: Project Settings → API (URL + anon/public key)
# Firebase: Firebase console → Project → Web app → SDK config,
#           plus a VAPID key (Project settings → Cloud Messaging).
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase Cloud Messaging (optional — push notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Hackathon demo contact for the SOS flow — console.log only, real SMS/FCM
# comes later. Set this in .env.local and in Vercel env vars.
NEXT_PUBLIC_DEMO_SOS_PHONE=

# WhatsApp Cloud API (Meta) — real SOS notifications to trusted contacts.
# Leave empty locally; fill in to enable sending (Vercel scope: Production/Preview).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Resend — email for SOS notifications to trusted contacts.
RESEND_API_KEY=

# Sender address for SOS emails. Leave empty for Resend's shared domain
# (onboarding@resend.dev — delivers only to your own inbox); set to
# sentinel@yourdomain.com once your domain is verified in Resend.
RESEND_FROM_EMAIL=

# Firebase Admin SDK (server-side) — high-priority FCM pushes from
# /api/sos-notify. Service account: Project settings → Service accounts →
# Generate new private key. Keep \n escapes in FIREBASE_ADMIN_PRIVATE_KEY.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase service role key (server-only) — reads contact FCM tokens and
# checks alert status for the escalating follow-up email. Never a client var.
SUPABASE_SERVICE_ROLE_KEY=